###  https://viewsari.ise.fiz-karlsruhe.de/ontology/0001028
<https://viewsari.ise.fiz-karlsruhe.de/ontology/0001028> rdf:type owl:NamedIndividual ,
                                                                  <https://viewsari.ise.fiz-karlsruhe.de/ontology/0001000> ;
                                                         <http://purl.org/dc/elements/1.1/date> 1568 ;
                                                         rdfs:comment """The 1568 Giunti (Giuntina) edition of
        Le Vite, published in Florence by the Giunti press. This is the
        canonical edition of The Lives, substantially expanded and
        revised relative to the first 1550 Torrentiniana edition, and
        is the source text on which the Du Vere English translation
        (viewsari:the_lives_1568) is based. All volume, biography,
        page, and paragraph instances in the Viewsari knowledge graph
        ultimately trace their editorial provenance to this
        edition.""" ;
                                                         rdfs:label "Le vite de' piu eccellenti pittori, scultori, e architettori"@it ,
                                                                    "le_vite_1568"@en ;
                                                         rdfs:seeAlso "https://www.wikidata.org/wiki/Q113560433" .


###  https://viewsari.ise.fiz-karlsruhe.de/ontology/0001029
<https://viewsari.ise.fiz-karlsruhe.de/ontology/0001029> rdf:type owl:NamedIndividual ,
                                                                  <https://viewsari.ise.fiz-karlsruhe.de/ontology/0001001> ;
                                                         <http://purl.org/vocab/frbr/core#embodiment> <https://viewsari.ise.fiz-karlsruhe.de/ontology/0001031> ;
                                                         <http://purl.org/dc/elements/1.1/creator> "Gaston C. du Vere" ;
                                                         <http://purl.org/dc/elements/1.1/date> "1912-1915" ;
                                                         rdfs:comment """The 1912 English translation of Le Vite
        by Gaston C. du Vere, published in ten volumes by Macmillan and
        the Medici Society (London, 1912–1914). This is the primary
        source text for all extraction and annotation in the Viewsari
        project. The translation follows the 1568 Giunti edition closely
        and is the version digitised by Project Gutenberg (EBook series
        starting at #25326). It is the parent of all ten
        viewsari:volume individuals in the knowledge
        graph.""" ;
                                                         rdfs:label "The Lives of the Most Eminent Painters Sculptors and Architects"@en ,
                                                                    "the_lives_1568"@en .


