  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#Milestone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This class describe elements that contain neither other elements nor textual content. Moreover, similarly to Inline, elements following the Milestone pattern can only be contained within block or inline elements (and consequently they also cannot be used as root elements of documents).

The distinctive characteristic of the pattern Milestone is the location it assumes within the document.</rdfs:comment>
    <rdfs:label xml:lang="en">milestone element</rdfs:label>
    <owl:equivalentClass rdf:nodeID="Nb24ab2cc3f124bd2ada6e0fd1f8de191"/>
    <rdfs:subClassOf rdf:nodeID="Nf75acf24cea64cebbf6c8f02c19aa75c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na17212e274fb4e10912ee2367a4d5246">
    <owl:onProperty rdf:resource="http://www.essepuntato.it/2008/12/pattern#canContainHeteronymousElements"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#hasName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of a particular element.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6378536f6ca44f439ed10bc3c2bf080a">
    <rdf:first rdf:resource="http://www.essepuntato.it/2008/12/pattern#Block"/>
    <rdf:rest rdf:nodeID="N7a3c5011e1404d09bdb5a664997ccb6a"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2c6dabcbad184410b7ed11e60ebd7882">
    <rdf:first rdf:nodeID="N4b7552570f854517833ffc46fe8d6999"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
