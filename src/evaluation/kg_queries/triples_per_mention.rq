# M05 — Average triples-per-mention. Counts triples whose subject OR object is
# a mention (viewsari:0001026), divided by the number of distinct mentions.

PREFIX viewsari: <https://viewsari.ise.fiz-karlsruhe.de/ontology/#>

SELECT
  (COUNT(DISTINCT ?m) AS ?mentions)
  (xsd:decimal(?triples) / xsd:decimal(COUNT(DISTINCT ?m)) AS ?ratio)
  (?triples AS ?totalTriplesAboutMentions)
WHERE {
  {
    SELECT (COUNT(*) AS ?triples) WHERE {
      ?s ?p ?o .
      { ?s a viewsari:0001026 } UNION { ?o a viewsari:0001026 }
    }
  }
  ?m a viewsari:0001026 .
}
