# CQ:        CQII.11
# Question:  Which locations are mentioned in co-occurrences involving artist X?
# Bindings:  X = Michelangelo

PREFIX viewsari: <https://viewsari.ise.fiz-karlsruhe.de/ontology/#>
PREFIX vkb:      <https://viewsari.ise.fiz-karlsruhe.de/kb/1.0#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?location ?locationLabel WHERE {
  ?cooc a viewsari:0001025 ;
        viewsari:involves vkb:buonarroti-michelagnolo .
  ?cooc viewsari:0001032 ?paragraph .
  ?location a viewsari:0001015 ;
            viewsari:0001032 ?paragraph .
  OPTIONAL { ?location rdfs:label ?locationLabel }
}
