# CQ:        CQII.21
# Question:  What is the direct web URL to the paragraph in the Project
#            Gutenberg edition from which entity E or co-occurrence C was
#            extracted?
# Bindings:  E = vkb:Q1069665

PREFIX viewsari: <https://viewsari.ise.fiz-karlsruhe.de/ontology/#>
PREFIX vkb:      <https://viewsari.ise.fiz-karlsruhe.de/kb/1.0#>
PREFIX frbr:     <http://purl.org/vocab/frbr/core#>
PREFIX dct:      <http://purl.org/dc/terms/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?paragraph ?pageWebRep ?webURL WHERE {
  vkb:Q1069665 viewsari:0001032 ?paragraph .
  {
    ?paragraph viewsari:hasStartPage ?pageWebRep .
  } UNION {
    ?paragraph dct:isPartOf ?page .
    ?page frbr:hasEmbodiment ?pageWebRep .
  }
  ?pageWebRep rdfs:seeAlso ?webURL .
}
LIMIT 10
