# CQ:        CQI.5
# Question:  How frequently do two given artists co-occur across the entire corpus?
# Bindings:  X = Michelangelo, Y = Raphael

PREFIX viewsari: <https://viewsari.ise.fiz-karlsruhe.de/ontology/#>
PREFIX vkb:      <https://viewsari.ise.fiz-karlsruhe.de/kb/1.0#>

SELECT (COUNT(DISTINCT ?cooc) AS ?frequency) WHERE {
  ?cooc a viewsari:0001025 ;
        viewsari:involves vkb:buonarroti-michelagnolo ,
                          vkb:sanzio-raffaello-raffaello-da-urbino .
}
