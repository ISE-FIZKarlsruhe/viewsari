# CQ:        CQII.6
# Question:  Which artworks in the biography of artist X are explicitly named,
#            and which are described only implicitly?
# Bindings:  X = Michelangelo

PREFIX viewsari: <https://viewsari.ise.fiz-karlsruhe.de/ontology/>
PREFIX vkb:      <https://viewsari.ise.fiz-karlsruhe.de/kb/1.0#>
PREFIX prov:     <http://www.w3.org/ns/prov#>
PREFIX frbr:     <http://purl.org/vocab/frbr/core#>
PREFIX oa:       <http://www.w3.org/ns/oa#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?artwork ?mentionType ?surfaceForm WHERE {
  ?paragraph frbr:isPartOf vkb:the_lives_1568_volume-9_michelangelo-bio .
  ?artwork a viewsari:0001012 ;
           prov:wasDerivedFrom ?mention .
  ?mention a ?mentionType ;
           viewsari:0001032 ?paragraph .
  FILTER (?mentionType IN (viewsari:0001020, viewsari:0001021))
  OPTIONAL {
    ?mention oa:hasBody ?body .
    ?body a oa:TextualBody ;
          rdf:value ?surfaceForm .
  }
}
LIMIT 200
