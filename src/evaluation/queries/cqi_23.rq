# CQ:        CQI.23
# Question:  What licence is provided by the Viewsari dataset and where can the
#            original source text be found?
# Notes:     Targets the ontology header (loaded alongside the KG when the runner
#            is invoked with --include-ontology) plus the Project-Gutenberg
#            anchor on the gutenberg manifestation node.

PREFIX viewsari: <https://viewsari.ise.fiz-karlsruhe.de/ontology/#>
PREFIX dc:       <http://purl.org/dc/elements/1.1/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?licence ?sourceURL WHERE {
  OPTIONAL { <https://viewsari.ise.fiz-karlsruhe.de/ontology/#> dc:rights ?licence }
  OPTIONAL { viewsari:0001031 rdfs:seeAlso ?sourceURL }
}
